generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  description         String
  shortDescription    String?
  price               Float?
  packageSize         String?
  imageUrl            String?
  // JSON-encoded array of additional photo URLs (e.g. '["/uploads/x.jpg", "/uploads/y.jpg"]')
  // Owner can add up to N gallery photos via the admin dashboard.
  galleryImages       String?
  ingredients         String?
  storageInstructions String?
  servingSuggestion   String?
  isActive            Boolean   @default(true)
  isFeatured          Boolean   @default(false)
  featuredOrder       Int       @default(0)
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  relatedArticleIds   String?
  // External marketplace links (optional)
  shopeeUrl           String?
  tokopediaUrl        String?
  // Toggle website checkout (display "Tambah ke Keranjang" on product page)
  websiteOrderEnabled Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  excerpt        String?
  content        String
  coverImageUrl  String?
  authorName     String           @default("Tim Dapur Ayam")
  categoryId     String?
  category       ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           String?
  status         String           @default("DRAFT")
  isFeatured     Boolean          @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([slug])
}

model SiteSettings {
  id               String   @id @default("default")
  businessName     String   @default("Dapur Ayam")
  tagline          String   @default("Nugget Ayam Praktis untuk Momen Makan Bersama")
  description      String?
  whatsappNumber   String?
  contactEmail     String?
  address          String?
  operationalHours String?
  instagramUrl     String?
  facebookUrl      String?
  tiktokUrl        String?
  footerText       String?
  heroHeadline     String?
  heroSubtext      String?
  // Marketplace links (global storefront)
  shopeeStoreUrl   String?
  tokopediaStoreUrl String?
  // Positioning statement (premium, fresh-made-by-order)
  positioningLabel String?
  freshnessNote    String?
  updatedAt        DateTime @updatedAt
}

// Order represents a customer's purchase request submitted via the website.
// Since checkout is still manual (admin confirms via WhatsApp), this is a "lead"
// that admin manages inside the CMS until a payment gateway is integrated later.
model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  // Customer info
  customerName  String
  customerPhone String
  customerEmail String?
  customerAddress String?
  customerNote  String?
  // Preferred channel: WEBSITE (this form), SHOPEE, WHATSAPP
  channel      String      @default("WEBSITE")
  // Status workflow: PENDING → CONFIRMED → PROCESSING → SHIPPED → COMPLETED / CANCELLED
  status       String      @default("PENDING")
  // Admin internal notes (not shown to customer)
  adminNote    String?
  // Optional snapshot fields (in case product details change later)
  totalItems   Int         @default(0)
  totalAmount  Float       @default(0)
  // Relation to items
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  productSlug String?
  // Snapshot price at the time of order
  unitPrice   Float    @default(0)
  quantity    Int      @default(1)
  subtotal   Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
